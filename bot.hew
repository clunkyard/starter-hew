// A robot on the Clunkyard core's Hew binding. The core owns tracking,
// geometry and protocol handling; this strategy chooses the tactics.
// Clunkyard robot API 2.0.0: one core under every language, the same
// answers everywhere. Facts (a call shows its arguments):
// match: mode ruleset control robots is_3d tick_rate max_ticks
//   robot_id(slot)
// clock: tick seconds remaining_ticks
// arena: size gravity terrain_kind ground_height(x y)
// me: health position velocity heading pitch roll angular_velocity
//   attitude grounded altitude wall_contact applied hull_mounts
//   to_mount(heading pitch) from_mount(heading pitch) mount_toward(point)
// battery: charge capacity regen sustainable_drive compute
//   drive_cost(fraction)
// drive: hover_lift
// gun: aim_now cooldown_ticks spread max_power damage_scale
//   can_fire(power reserve) shot_speed(power) shot_cost(power)
//   reload_ticks(power) shot_damage(power) power_for_speed(speed)
//   power_for_flight_time(range seconds) lead(contact power)
//   lead_point(position velocity power)
// scanner: last proximity_range reach(arc) arc_for_reach(range) is_on
// sensors: contacts nearest cues contact(slot) position_of(contact)
// tracker: cue nearest_bearing_rate velocity(slot) position(slot)
//   history(slot) last_seen(slot)
// nav: zone zone.margin(point) zone.contains(point margin)
//   zone.distance_from(point) storm storm.margin(point)
//   storm.contains(point margin) storm.distance_from(point) hill
//   hill.margin(point) hill.contains(point margin)
//   hill.distance_from(point) wall_margin() pickups nearest_pickup(kind)
//   field_distance(a b)
// score: me best armour
// angles: normalize(degrees) angle_diff(target current)
//   bearing_to(from to) elevation_to(from to) direction(heading pitch)
//   distance(a b) to_chassis(heading pitch attitude)
//   from_chassis(heading pitch attitude) clamp(value low high)
// raw: number(path) text(path) has(path) flag(path) count(path) line()
// Controls: drive.set(throttle turn pitch_turn)
//   drive.forces(thrust strafe lift yaw_torque pitch_torque roll_torque brake)
//   gun.aim(heading pitch) gun.fire(power) scanner.set(heading arc pitch)
//   scanner.power(on) tracker.configure(smoothing forget_ticks cue_ticks)
//   status.set(text value) debug.log(line) raw.extra(json)
// Every control argument is optional; a second call keeps what the first
// set. Absent facts are your language's none. Names are snake_case here;
// your language cases them its own way. Angles are degrees from the +x
// axis; pitch is positive up.
// Manual: https://clunkyard.com/manual#sdk
import hew.clunkyard;
import hew.clunkyard.{Robot, Strategy, CoreError, Direction, Vec3};
import std.math;

// Bearing is earned: a scan contact's bearing is off by up to its
// bearing_error (degrees, a fixed share of the arc), so a wide beam finds a
// robot and a narrow one aims at it. Contacts within 120 units are exact.
const SEARCH_ARC: f64 = 40.0;  // degrees: sweeps the circle in half a second
const HOLD_WIDTH: f64 = 60.0;  // units across at the target: it stays in the beam from tick to tick
const MIN_ARC: f64 = 6.0;      // degrees: the narrowest the beam holds
const WINDOW: i32 = 12;        // ticks of sightings the aim averages
const SIGHTINGS: i32 = 8;      // narrow sightings in the window before a shot
const LOOK_EVERY: i32 = 40;    // ticks between looks around the target, for a nearer robot
const REACQUIRE: i32 = 10;     // ticks to look again where a lost target was

// The tick the dodge ends, how many dodges so far, and the last target's slot.
type Starter { free_flight: bool; dodge_until: i32; dodges: i32; slot: i32; }
// A line through recent sightings: where the robot is now, how fast it moves,
// and how many sightings it rests on (under 2: no fit).
type Fit { position: Vec3; velocity: Vec3; count: i32; }
// A straight line through the narrowest of the last WINDOW ticks' sightings.
// Each sighting is off by its bearing_error; the line averages that out.
fn fit(robot: Robot, slot: i32, tick: i32) -> Fit fails CoreError {
    let none = Vec3 { x: 0.0, y: 0.0, z: 0.0 };
    let history = robot.tracker.history(slot)?;
    var best = 1000000.0;
    for s in history {
        if s.tick > tick - WINDOW && s.bearing_error < best { best = s.bearing_error; }
    }
    var n: i32 = 0;
    var t_sum = 0.0;
    var x_sum = 0.0;
    var y_sum = 0.0;
    var z_sum = 0.0;
    for s in history {
        if s.tick > tick - WINDOW && s.bearing_error <= 1.5 * best {
            n = n + 1;
            t_sum = t_sum + (s.tick as f64);
            x_sum = x_sum + s.position.x;
            y_sum = y_sum + s.position.y;
            z_sum = z_sum + s.position.z;
        }
    }
    if n < 2 { return Fit { position: none, velocity: none, count: 0 }; }
    let t0 = t_sum / (n as f64);
    let mx = x_sum / (n as f64);
    let my = y_sum / (n as f64);
    let mz = z_sum / (n as f64);
    var spread = 0.0;
    var sx = 0.0;
    var sy = 0.0;
    var sz = 0.0;
    for s in history {
        if s.tick > tick - WINDOW && s.bearing_error <= 1.5 * best {
            let dt = (s.tick as f64) - t0;
            spread = spread + dt * dt;
            sx = sx + dt * (s.position.x - mx);
            sy = sy + dt * (s.position.y - my);
            sz = sz + dt * (s.position.z - mz);
        }
    }
    let ahead = (tick as f64) - t0;
    let rate = robot.match_info.tick_rate()? as f64;
    let kx = sx / spread;
    let ky = sy / spread;
    let kz = sz / spread;
    Fit {
        position: Vec3 { x: mx + kx * ahead, y: my + ky * ahead, z: mz + kz * ahead },
        velocity: Vec3 { x: kx * rate, y: ky * rate, z: kz * rate },
        count: n,
    }
}
fn steer(robot: Robot, towards: f64, current: f64, scale: f64 = 45.0) -> f64 fails CoreError {
    robot.angles.clamp(robot.angles.angle_diff(towards, current)? / scale)?
}
impl Strategy for Starter {
    fn on_start(var self, robot: Robot) fails CoreError {
        self.free_flight = robot.match_info.is_3d()? && (robot.arena.gravity()?).z == 0.0;
    }
    fn on_turn(var self, robot: Robot) fails CoreError {
        let position = robot.me.position()?;
        let heading = robot.me.heading()?;
        let pitch = robot.me.pitch()?;
        let tick = robot.clock.tick()?;
        let scanned = robot.scanner.last()?;
        robot.drive.forces(brake: .Some(0.2))?;
        // The last target, if it was seen within REACQUIRE ticks.
        var lost: Option<Vec3> = .None;
        if self.slot != 0 {
            if let .Some(at) = robot.tracker.last_seen(self.slot)? {
                if tick - at <= REACQUIRE { lost = robot.tracker.position(self.slot)?; }
            }
        }
        match robot.sensors.nearest()? {
            .Some(target) => {
                let throttle = if target.range > 350.0 { 0.7 } else if target.range < 200.0 { -0.4 } else { 0.2 };
                self.slot = target.slot;
                robot.drive.set(.Some(throttle), .Some(steer(robot, target.bearing, heading)?), .Some(steer(robot, target.elevation, pitch)?))?;
                // Halve the beam each tick until it is HOLD_WIDTH across at the target:
                // narrow enough for a precise bearing, wide enough to keep it in.
                let hold = math.max(MIN_ARC, 2.0 * math.atan2(HOLD_WIDTH / 2.0, target.range) * 180.0 / math.pi());
                // In a crowd a narrow beam sees one robot: every LOOK_EVERY ticks, widen it for a tick.
                let halved = math.min(SEARCH_ARC, scanned.arc / 2.0);
                let arc = if tick % LOOK_EVERY == 0 { SEARCH_ARC } else { math.max(hold, halved) };
                robot.scanner.set(.Some(target.bearing), .Some(arc), .Some(target.elevation))?;
                let power = robot.gun.power_for_flight_time(target.range, 1.0)?;
                // An exact contact: the lead is the intercept if the target holds its
                // course. A noisy one: lead the fitted line, and fire only once it
                // rests on enough sightings.
                var ready = true;
                var led: Option<clunkyard.Solution> = .None;
                if target.bearing_error > 0.0 {
                    let line = fit(robot, target.slot, tick)?;
                    if line.count >= 2 { led = robot.gun.lead_point(line.position, line.velocity, power)?; }
                    ready = line.count >= SIGHTINGS;
                } else {
                    led = robot.gun.lead(target, power)?;
                }
                let aim = match led {
                    .Some(aim) => Direction { heading: aim.heading, pitch: aim.pitch },
                    .None => Direction { heading: target.bearing, pitch: target.elevation },
                };
                robot.gun.aim(.Some(aim.heading), .Some(aim.pitch))?;
                let now = robot.gun.aim_now()?;
                if ready && math.abs(robot.angles.angle_diff(aim.heading, now.heading)?) < 3.0 && math.abs(aim.pitch - now.pitch) < 3.0 && robot.gun.can_fire(power, 10.0)? {
                    robot.gun.fire(.Some(power))?;
                }
                robot.status.set(.Some(if ready { "TRACK" } else { "NARROW" }), .Some(target.range))?;
            }
            .None => match lost {
                .Some(spot) => {
                    // Lost it: look again where it was last seen, widening the beam, before searching.
                    let bearing = robot.angles.bearing_to(position, spot)?;
                    let elevation = if self.free_flight { robot.angles.elevation_to(position, spot)? } else { 0.0 };
                    robot.drive.set(.Some(0.5), .Some(steer(robot, bearing, heading)?), .Some(steer(robot, elevation, pitch)?))?;
                    robot.scanner.set(.Some(bearing), .Some(math.min(SEARCH_ARC, scanned.arc * 2.0)), .Some(elevation))?;
                    robot.status.set(.Some("REACQUIRE"))?;
                }
                .None => match robot.tracker.cue()? {
                .Some(cue) => {
                    let bearing = robot.angles.bearing_to(position, cue.position)?;
                    let distance = robot.angles.distance(position, cue.position)?;
                    let elevation = if self.free_flight { robot.angles.elevation_to(position, cue.position)? } else { 0.0 };
                    let spread = if cue.bearing_error < 30.0 { cue.bearing_error } else { 30.0 };
                    let across = ((tick % 5 - 2) as f64) / 2.0 * spread;
                    let up = if self.free_flight { (((tick / 5) % 3 - 1) as f64) * spread / 2.0 } else { 0.0 };
                    robot.drive.set(.Some(0.7), .Some(steer(robot, bearing, heading)?), .Some(steer(robot, elevation, pitch)?))?;
                    robot.scanner.set(.Some(bearing + across), .Some(robot.scanner.arc_for_reach(distance + 100.0)?), .Some(elevation + up))?;
                    robot.status.set(.Some("CUE"), .Some(distance))?;
                }
                .None => {
                    robot.drive.set(.Some(0.5), .Some(0.33), .Some(steer(robot, 0.0, pitch)?))?;
                    let elevation = if self.free_flight { (((tick / 10) % 3 - 1) as f64) * 35.0 } else { 0.0 };
                    robot.scanner.set(.Some(robot.angles.normalize(scanned.heading + 36.0)?), .Some(40.0), .Some(elevation))?;
                    robot.status.set(.Some("SEARCH"))?;
                }
                }
            }
        }
        // A simple dodge: vary it, or predict the shooter. A muzzle cue means a
        // robot fired; for half a second swerve off the line of fire, left and
        // right in turn.
        if tick >= self.dodge_until {
            for cue in robot.sensors.cues()? {
                if cue.source == clunkyard.SOURCE_MUZZLE { self.dodge_until = tick + 10; self.dodges = self.dodges + 1; break; }
            }
        }
        if tick < self.dodge_until {
            // Turn is positive left, strafe positive right.
            let left = self.dodges % 2 == 1;
            let side = if left { 1.0 } else { -1.0 };
            if robot.match_info.control()? == clunkyard.CONTROL_FORCES {
                robot.drive.set(throttle: .Some(0.5))?;
                robot.drive.forces(strafe: .Some(-side))?;
            } else {
                robot.drive.set(.Some(1.0), .Some(side))?;
            }
            robot.status.set(.Some(if left { "dodge:left" } else { "dodge:right" }), .Some(self.dodges as f64))?;
        }
        if robot.battery.charge()? < robot.battery.capacity()? / 4.0 {
            if let .Some(throttle) = robot.drive.get_throttle()? { robot.drive.set(throttle: .Some(throttle * 0.5))?; }
        }
        if let .Some(storm) = robot.nav.storm()? {
            if let .Some(margin) = storm.margin(position)? {
                if margin > -60.0 { robot.drive.set(.Some(0.8), .Some(steer(robot, robot.angles.bearing_to(storm.center, position)?, heading, 30.0)?))?; }
            }
        }
        if let .Some(zone) = robot.nav.zone()? {
            if let .Some(margin) = zone.margin(position)? {
                if margin < 60.0 {
                    let climb = if zone.shape == clunkyard.SHAPE_SPHERE { robot.angles.elevation_to(position, zone.center)? } else { 0.0 };
                    robot.drive.set(.Some(0.8), .Some(steer(robot, robot.angles.bearing_to(position, zone.center)?, heading, 30.0)?), .Some(robot.angles.clamp((climb - pitch) / 30.0)?))?;
                }
            }
        }
    }
}
fn main() { let _ = clunkyard.run(Starter { free_flight: false, dodge_until: 0, dodges: 0, slot: 0 }); }
